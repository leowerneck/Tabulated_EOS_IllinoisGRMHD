void FUNCTION WVU_EOS_P_S_T_and_depsdT_from_rho_Ye_eps( CCTK_REAL IN rho,     \
                                                        CCTK_REAL IN Ye,      \
                                                        CCTK_REAL IN eps,     \
                                                        CCTK_REAL OUT P,      \
                                                        CCTK_REAL OUT S,      \
                                                        CCTK_REAL OUT depsdT, \
                                                        CCTK_REAL OUT T )

USES FUNCTION WVU_EOS_P_S_T_and_depsdT_from_rho_Ye_eps
# ------------------------------------------------------
