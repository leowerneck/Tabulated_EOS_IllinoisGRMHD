                                                 CCTK_REAL IN Ye,   \
                                                 CCTK_REAL IN P,    \
                                                 CCTK_REAL OUT eps, \
                                                 CCTK_REAL OUT S,   \
                                                 CCTK_REAL OUT T )

USES FUNCTION WVU_EOS_eps_S_and_T_from_rho_Ye_P
# ------------------------------------------------------
void FUNCTION WVU_EOS_P_eps_and_T_from_rho_Ye_S( CCTK_REAL IN rho,  \
                                                 CCTK_REAL IN Ye,   \
                                                 CCTK_REAL IN S,    \
                                                 CCTK_REAL OUT P,   \
                                                 CCTK_REAL OUT eps, \
                                                 CCTK_REAL OUT T )

USES FUNCTION WVU_EOS_P_eps_and_T_from_rho_Ye_S
