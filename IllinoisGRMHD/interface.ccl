                                                        CCTK_REAL IN Ye,      \
                                                        CCTK_REAL IN eps,     \
                                                        CCTK_REAL OUT P,      \
                                                        CCTK_REAL OUT S,      \
                                                        CCTK_REAL OUT depsdT, \
                                                        CCTK_REAL OUT T )

