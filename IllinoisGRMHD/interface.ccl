                                               CCTK_REAL IN Ye,  \
                                               CCTK_REAL IN T,   \
                                               CCTK_REAL OUT P,  \
                                               CCTK_REAL OUT eps )

USES FUNCTION WVU_EOS_P_and_eps_from_rho_Ye_T
