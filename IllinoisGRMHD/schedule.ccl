# Schedule for thorn IllinoisGRMHD

# This should be done by HydroBase by setting initial_Bvec, initial_Avec, initial_Aphi
STORAGE: HydroBase::Bvec[1], HydroBase::Avec[1], HydroBase::Aphi[1]
STORAGE: BSSN_quantities

STORAGE: grmhd_conservatives[3], Ax[3], Ay[3], Az[3], phitilde[3]
STORAGE: grmhd_primitives_allbutBi, grmhd_B_center, grmhd_B_stagger
STORAGE: grmhd_conservatives_rhs, EM_rhs
STORAGE: grmhd_primitives_reconstructed_temps, grmhd_cmin_cmax_temps, failure_checker
STORAGE: grmhd_flux_temps, con2prim_failed_flag

####################
# NEW STUFF
schedule IllinoisGRMHD_EOS_get_key at BASEGRID after EOS_OMNI_get_energy_shift
{
  LANG: C
  OPTIONS: GLOBAL
} "Get EOS handle for IllinoisGRMHD's interface with EOS_Omni"

STORAGE: igm_eos_key

####################
# PARAMETER CHECK
schedule IllinoisGRMHD_parameter_check at BASEGRID after IllinoisGRMHD_EOS_get_key
{
  LANG: C
  OPTIONS: GLOBAL
} "Check input parameters"

#########################################################
# BASIC SETUP
#########################################################
# Registration of MoL RHS, symmetries, and boundary conditions (for PreSync)
schedule IllinoisGRMHD_RegisterVars in MoL_Register
{
  LANG: C
  OPTIONS: META
} "Register evolved, rhs variables in IllinoisGRMHD for MoL"

# Registers boundary conditions with PreSync
schedule IllinoisGRMHD_specify_driver_BCs in Driver_BoundarySelect
{
  LANG: C
  OPTIONS: META
} "Register boundary conditions with PreSync"

# Tells the symmetry thorn how to apply symmetries on each gridfunction
schedule IllinoisGRMHD_InitSymBound at BASEGRID
{
  LANG: C
} "Schedule symmetries"

#########################################################
# INITIAL DATA CONVERSION
#########################################################
# Fill IllinoisGRMHD grid functions using initial data from ADMBase and HydroBase
schedule group IllinoisGRMHD_Prim2Con2Prim in HydroBase_Prim2ConInitial
{
} "Convert HydroBase initial data to IllinoisGRMHD variables"

schedule set_IllinoisGRMHD_metric_GRMHD_variables_based_on_HydroBase_and_ADMBase_variables IN IllinoisGRMHD_Prim2Con2Prim as first_initialdata before TOV_Initial_Data
{
   LANG:       C
   OPTIONS:    LOCAL
   # What the heck, let's synchronize everything!
   SYNC: grmhd_B_center, grmhd_B_stagger, grmhd_primitives_allbutBi, HydroBase::rho, HydroBase::press, HydroBase::eps, HydroBase::Y_e, HydroBase::temperature, HydroBase::entropy, Ax,Ay,Az,phitilde,grmhd_conservatives,BSSN_quantities,ADMBase::metric,ADMBase::lapse,ADMBase::shift,ADMBase::curv
} "Convert HydroBase initial data (ID) to ID that IllinoisGRMHD can read."

# Runs everywhere. Shouldn't need to sync
schedule IllinoisGRMHD_compute_B_and_Bstagger_from_A in IllinoisGRMHD_Prim2Con2Prim as fourth_initialdata after third_initialdata
{
  LANG: C
  READS:  GRID::coordinates,
          ADMBase::metric, ADMBase::lapse, ADMBase::shift,
          phitilde, Ax, Ay, Az
  #Technically only writes Ai and phitilde in symmetry gz's
  WRITES: phitilde(everywhere), Ax(everywhere), Ay(everywhere), Az(everywhere),
          grmhd_B_center(everywhere), grmhd_B_stagger(everywhere)
  SYNC: grmhd_B_center, grmhd_B_stagger
} "Compute B and B_stagger from A"

schedule IllinoisGRMHD_conserv_to_prims in IllinoisGRMHD_Prim2Con2Prim after fourth_initialdata
{
  LANG: C
} "Compute primitive variables from conservatives"

if(Convert_to_HydroBase_every) {
  schedule convert_IllinoisGRMHD_to_HydroBase in IllinoisGRMHD_Prim2Con2Prim after IllinoisGRMHD_conserv_to_prims
  {
    LANG: C
    READS:  ADMBase::metric, ADMBase::lapse, ADMBase::shift,
            grmhd_primitives_allbutBi, grmhd_B_center
    WRITES: HydroBase::vel(everywhere), HydroBase::w_lorentz(everywhere),
            HydroBase::Bvec(everywhere)
  } "Convert IllinoisGRMHD-native variables to HydroBase"
}

#########################################################
# Symmetry setup (inherited from IllinoisGRMHD, where
# it is still incomplete)
#########################################################

schedule GROUP IllinoisGRMHD_PostPostInitial at CCTK_POSTPOSTINITIAL before MoL_PostStep after HydroBase_Con2Prim
{
} "HydroBase_Con2Prim in CCTK_PostPostInitial sets conserv to prim then outer boundaries (OBs, which are technically disabled). The post OB SYNCs actually reprolongate the conservative variables, making cons and prims INCONSISTENT. So here we redo the con2prim, avoiding the SYNC afterward, then copy the result to other timelevels"

schedule IllinoisGRMHD_InitSymBound in IllinoisGRMHD_PostPostInitial as postid before compute_b
{
  SYNC: grmhd_conservatives,Ax,Ay,Az,phitilde
  LANG: C
} "Schedule symmetries -- Actually just a placeholder function to ensure prolongations / processor syncs are done BEFORE outer boundaries are updated."

schedule IllinoisGRMHD_outer_boundaries_on_A_mu in IllinoisGRMHD_PostPostInitial after postid before compute_b
{
  LANG: C
  READS:  phitilde, Ax, Ay, Az
  WRITES: phitilde(boundary), Ax(boundary), Ay(boundary), Az(boundary)
} "Apply linear extrapolation BCs on A_{mu}, so that BCs are flat on B^i"

# Easiest primitives to solve for: B^i
schedule IllinoisGRMHD_compute_B_and_Bstagger_from_A in IllinoisGRMHD_PostPostInitial as compute_b after postid after empostid after lapsepostid
{
  # This is strictly a processor sync, as prolongation is disabled for all primitives & B^i's.
  SYNC: grmhd_B_center,grmhd_B_stagger # FIXME: Are both SYNC's necessary?
  LANG: C
} "Compute B and B_stagger from A SYNC: grmhd_B_center,grmhd_B_stagger"

# Nontrivial primitives solve, for P,rho_b,vx,vy,vz:
schedule IllinoisGRMHD_conserv_to_prims in IllinoisGRMHD_PostPostInitial after compute_b
{
  LANG: C
} "Compute primitive variables from conservatives. This is non-trivial, requiring a Newton-Raphson root-finder."

schedule IllinoisGRMHD_outer_boundaries_on_P_rho_b_vx_vy_vz in IllinoisGRMHD_PostPostInitial after IllinoisGRMHD_conserv_to_prims
{
  LANG: C
  SYNC: grmhd_primitives_allbutBi, HydroBase::rho, HydroBase::press, HydroBase::eps, HydroBase::Y_e, HydroBase::temperature, HydroBase::entropy
} "Apply outflow-only, flat BCs on {P,rho_b,vx,vy,vz}. Outflow only == velocities pointed inward from outer boundary are set to zero."

schedule IllinoisGRMHD_PostPostInitial_Set_Symmetries__Copy_Timelevels in IllinoisGRMHD_PostPostInitial as mhdpostid after compute_b after p2c
{
  LANG: C
  READS:  GRID::coordinates
  READS: grmhd_B_center, grmhd_B_stagger, phitilde, Ax, Ay, Az
  #Technically only writes B^i, A_i, and phitilde in symmetry gz's
  WRITES: grmhd_B_center(boundary), grmhd_B_stagger(boundary),
          phitilde(boundary), Ax(boundary), Ay(boundary), Az(boundary)
} "Compute post-initialdata quantities"

#########################################################
# Con2Prim
#########################################################

schedule IllinoisGRMHD_InitSymBound in HydroBase_Boundaries as Boundary_SYNCs before compute_B_postrestrict
{
  LANG: C
  SYNC: grmhd_conservatives, Ax, Ay, Az, phitilde
} "Sync conservative variable ghost zones for c2p routine"

schedule IllinoisGRMHD_outer_boundaries_on_A_mu in HydroBase_Boundaries after Boundary_SYNCs before mhd_conserv2prims_postrestrict
{
  LANG: C
  READS:  phitilde, Ax, Ay, Az
  WRITES: phitilde(boundary), Ax(boundary), Ay(boundary), Az(boundary)
} "Apply linear extrapolation BCs on A_{mu}, so that BCs are flat on B^i"

schedule IllinoisGRMHD_compute_B_and_Bstagger_from_A in HydroBase_Boundaries after outer_boundaries_on_A_mu
{
  LANG: C
  READS:  GRID::coordinates
  READS:  ADMBase::metric, ADMBase::lapse, ADMBase::shift
  READS:  phitilde, Ax, Ay, Az
  #Technically only writes Ai and phitilde in symmetry gz's
  WRITES: phitilde(everywhere), Ax(everywhere), Ay(everywhere), Az(everywhere),
          grmhd_B_center(everywhere), grmhd_B_stagger(everywhere)
  SYNC: grmhd_B_center,grmhd_B_stagger # FIXME: Are both SYNC's necessary?
} "Compute B and B_stagger from A SYNC: grmhd_B_center, grmhd_B_stagger"

schedule IllinoisGRMHD_conserv_to_prims in AddToTmunu after IllinoisGRMHD_compute_B_and_Bstagger_from_A
{
  LANG: C
} "Compute primitive variables from conservatives"

schedule IllinoisGRMHD_outer_boundaries_on_P_rho_b_vx_vy_vz in AddToTmunu after IllinoisGRMHD_conserv_to_prims
{
  LANG: C
  SYNC: grmhd_primitives_allbutBi, HydroBase::rho, HydroBase::press, HydroBase::eps, HydroBase::Y_e, HydroBase::temperature, HydroBase::entropy
} "Apply selected boundary conditions to the primitive variables"

